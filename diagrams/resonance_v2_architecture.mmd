%% Resonance v2.0 -- one complete recommendation cycle
%% The recommendation engine (Recommender) is unchanged from v1 and is a tool
%% the ResonanceAgent calls, never the other way around. AgentConfig supplies
%% the bounded, evidence-based preference-drift thresholds shown below.
sequenceDiagram
    participant Caller as Caller (CLI / Streamlit)
    participant Agent as ResonanceAgent
    participant Config as AgentConfig
    participant Profile as UserProfile (snapshot)
    participant Engine as Recommender (engine)

    Note over Caller,Agent: Earlier in the session...
    Caller->>Agent: observe_feedback(song_id, "skip")
    Agent->>Agent: validate event_type, resolve song, append to pending_feedback + feedback_log

    Caller->>Agent: observe_feedback(song_id, "replay")
    Agent->>Agent: append to pending_feedback + feedback_log

    Note over Caller,Agent: New cycle begins
    Caller->>Agent: run_cycle(k=5)

    Agent->>Profile: snapshot current profile (profile_before)

    Agent->>Config: read min_feedback_for_drift
    alt pending feedback below threshold
        Agent->>Agent: no profile changes this cycle (one interaction never dramatically changes the profile)
    else pending feedback meets threshold
        Agent->>Config: read max_tempo_step / max_valence_step / max_danceability_step / max_decade_step / categorical_shift_threshold
        Agent->>Agent: compute bounded, evidence-based field changes (numeric: move toward/away from evidence mean, clamped; categorical: shift only on a repeated majority signal)
        Agent->>Profile: mutate current profile in place
    end

    Agent->>Profile: snapshot current profile (profile_after)

    Agent->>Engine: recommend(current_profile, k)
    Engine-->>Agent: ranked List[Song]

    loop for each recommended song
        Agent->>Engine: explain_recommendation(current_profile, song)
        Engine-->>Agent: per-song reason string (Layer 1 explanation: "why this song")
    end

    Agent->>Agent: evaluate_quality(songs) -> quality warnings (empty list, duplicate artists, single-genre dominance)
    Agent->>Agent: explain_change(update) -> change explanation (Layer 2 explanation: "why did my recommendations change")

    Agent->>Agent: append RecommendationCycle to history

    Agent-->>Caller: RecommendationCycle (recommendations + explanations + quality_warnings + change_explanation)
